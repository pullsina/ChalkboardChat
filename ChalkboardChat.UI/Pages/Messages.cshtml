@page
@model ChalkboardChat.UI.Pages.MessagesModel

<h2>Message board</h2>

<div class="messages">
    @foreach (var msg in Model.Messages)
    {
        <div class="message @(msg.IsMine ? "mine" : "other")">
            <div class="meta">
                <strong>@msg.Username</strong>
                <span>@msg.Date.ToString("yyyy-MM-dd HH:mm")</span>
            </div>

            @if (msg.IsDeleted)
            {
                <p class="deleted-text">Message was deleted by its owner</p>
            }
            else
            {
                <p>@msg.Text</p>
            }
            else
            {
            <p>@msg.Text</p>
            @if ( msg.IsMine)
            {
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="id" value="@msg.Id" />
                    <button type="submit">Delete</button>
                </form>
            }
            }         
        </div>
    }
</div>

<form method="post" class="post-form">
    <textarea asp-for="NewMessageText" placeholder="Write a message..."></textarea>
    <button type="submit">Post</button>
</form>
