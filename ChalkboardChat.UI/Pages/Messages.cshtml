@page
@model MessagesModel

<h2 class="title">Message Board</h2>

<div class="messages-container">
    @foreach (var msg in Model.Messages)
    {
        <div class="message @(msg.IsMine ? "mine" : "other")">
            <div class="message-header">
                <span class="username">@msg.Username</span>
                <span class="date">@msg.Date.ToString("yyyy-MM-dd HH:mm")</span>
            </div>

                <p class="text">@msg.Text</p>

                @if (msg.IsMine)
                {
                    <form method="post" asp-page-handler="Delete" class="delete-form">
                        <input type="hidden" name="id" value="@msg.Id" />
                        <button type="submit" class="delete-btn">Delete</button>
                    </form>
                }
        </div>
    }
</div>

<form method="post" class="post-form">
    <textarea asp-for="NewMessageText" placeholder="Write a message..." class="input-area"></textarea>
    <button type="submit" class="send-btn">Send</button>
</form>